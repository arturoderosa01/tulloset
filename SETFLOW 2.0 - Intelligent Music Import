</style></head><body><header><div style="color:#caff45;font-size:38px">▂▅▃▇▅▆</div><div><div class="logo">SETFLOW</div><small>THE INTELLIGENT SETLIST</small><div style="font-size:12px;margin-top:8px;font-style:italic">Created by Arturo De Rosa</div></div></header><main><div class="intro"><h1>Build your show.</h1><p class="muted">Il tuo repertorio. La tua energia. La scaletta perfetta.</p></div><div class="stats"><div class="stat"><small>BRANI</small><strong id="count">0</strong></div><div class="stat"><small>DURATA</small><strong id="time">0:00</strong></div><div class="stat"><small>ENERGIA MEDIA</small><strong id="average">—</strong></div></div>
<section class="panel" id="libraries"><h2>01 — I tuoi repertori</h2><div class="fields"><div><label>Repertorio attivo</label><select id="librarySelect"></select></div><div><label>Nome band</label><input id="band" placeholder="Nome della band"></div><div><label>Logo band (facoltativo)</label><input id="logoFile" type="file" accept="image/png,image/jpeg,image/webp"></div></div><div class="actions"><button id="newLib">Nuovo repertorio</button><button class="secondary" id="renameLib">Rinomina</button><button class="secondary danger" id="removeLib">Elimina repertorio</button><button class="secondary" id="backup">Esporta backup</button><button class="secondary" id="restoreBtn">Importa backup</button><input type="file" id="restoreFile" accept=".json" hidden></div><small id="storageStatus"></small></section>
<section class="panel" id="import"><h2>02 — Importa brani</h2><label for="search">Cerca titolo e artista nel catalogo iTunes</label><div class="actions"><input id="search" placeholder="Es. Albachiara Vasco Rossi" style="flex:1;min-width:180px"><button id="searchBtn">Cerca</button></div><div id="searchResults"></div><p class="muted">Titolo, artista, durata e genere dal catalogo quando disponibili. Energia indicativa per genere, non analisi audio; BPM da inserire manualmente.</p><label for="bulk">Incolla repertorio — un brano per riga, formato Titolo - Artista</label><textarea id="bulk" rows="5" placeholder="Albachiara - Vasco Rossi&#10;Certe notti - Ligabue"></textarea><div class="actions"><button id="bulkBtn">Importa elenco</button><button class="secondary" id="enrichBtn">Cerca dati mancanti online</button><button class="secondary" id="stopBtn" disabled>Interrompi ricerca</button></div><label>Importa CSV / Excel (.csv, .xlsx, .xls)</label><input id="file" type="file" accept=".csv,.xlsx,.xls"><p class="muted">Colonne: Titolo, Artista, Durata (mm:ss), BPM, Energia (1–10). Solo il titolo è obbligatorio. I dati mancanti restano da verificare.</p><p id="importStatus" role="status" class="accent"></p></section>
<section class="panel" id="manual"><h2>03 — Aggiungi o modifica brano</h2><form id="songForm"><div class="fields"><div><label>Titolo</label><input id="title" required></div><div><label>Artista</label><input id="artist"></div><div><label>Durata (mm:ss)</label><input id="duration" placeholder="4:00" pattern="[0-9]{1,3}:[0-5][0-9]"></div><div><label>BPM</label><input id="bpm" type="number" min="20" max="350"></div><div><label>Energia (1–10)</label><input id="energy" type="number" min="1" max="10" step="1" placeholder="Da valutare"></div></div><div class="actions"><button id="addBtn">Aggiungi brano</button><button type="button" class="secondary" id="cancelEdit">Annulla</button><button type="button" class="secondary" id="demo">Carica repertorio demo</button></div></form></section>
<section class="panel" id="repertoire"><h2>04 — Il tuo repertorio</h2><div class="scroll"><table><thead><tr><th>Brano</th><th>Durata</th><th>BPM</th><th>Energia</th><th>Azioni</th></tr></thead><tbody id="songs"></tbody></table></div><p class="muted" id="missing"></p><button class="secondary danger" id="clear">Svuota repertorio</button></section>
<section class="panel" id="settings"><h2>05 — Configura il concerto</h2><div class="fields"><div><label>Nome scaletta</label><input id="showName" value="My Live Show"></div><div><label>Stile</label><select id="style"><option value="live">Live — crescendo e climax</option><option value="party">Party — alta energia</option><option value="theatre">Teatro — emozione</option><option value="rock">Rock — potenza</option></select></div><div><label>Durata massima (minuti, vuoto = tutti)</label><input id="limit" type="number" min="1" max="1440"></div><div><label>Brani del bis (inclusi nella durata)</label><select id="encore"><option>0</option><option>1</option><option>2</option><option>3</option></select></div></div><div class="actions"><button id="generate">✦ Genera scaletta intelligente</button><button class="secondary" id="saveShow">Salva scaletta in archivio</button></div><div class="actions"><select id="savedShows" style="flex:1"><option value="">Scalette archiviate</option></select><button class="secondary" id="openShow">Apri</button><button class="secondary danger" id="deleteShow">Elimina</button></div><p id="message" class="accent" role="status"></p></section>
<section class="panel" id="result" hidden><img id="bandLogo" hidden alt="Logo band"><div id="bandTitle" class="accent"></div><h2 id="resultTitle"></h2><p id="resultInfo"></p><div class="scroll"><table><thead><tr><th>#</th><th>Brano</th><th>Durata</th><th>Energia</th><th>Fase</th><th class="no-print">Ordine</th></tr></thead><tbody id="setlist"></tbody></table></div><div class="actions no-print"><button id="print">Stampa / PDF</button><button class="secondary" id="copy">Copia scaletta</button><button class="secondary" id="stage">Modalità palco</button></div></section><section class="panel" id="graph" hidden><h2>06 — Energy Flow</h2><svg id="chart" viewBox="0 0 700 280" role="img" aria-label="Curva energetica"></svg><small>Verde: energia utilizzata. Tratteggio: obiettivo. I valori mancanti sono trattati come 6/10 provvisorio.</small></section></main><footer>SETFLOW 2.0 — DESIGNED FOR LIVE MUSICIANS<br>Created by Arturo De Rosa<br>© 2026 Arturo De Rosa — All Rights Reserved.</footer>
<script>
'use strict';const $=id=>document.getElementById(id),uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2),esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),norm=x=>String(x??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^\p{L}\p{N}]+/gu,' ').trim();const curves={live:[7,8,5,6,7,9,8,3,5,7,9,10],party:[8,9,7,8,9,9,7,6,8,9,9,10],theatre:[6,7,4,3,6,9,7,2,4,6,8,10],rock:[8,9,6,7,8,9,8,4,7,8,9,10]};
function fmt(s){s=Math.round(s);return Math.floor(s/60)+':'+String(s%60).padStart(2,'0')}function secs(s){return /^\d{1,3}:[0-5]\d$/.test(s||'')?s.split(':').reduce((a,b)=>a*60+Number(b),0):0}function dur(s){return secs(s.duration)||240}function en(s){return s.energy||6}function total(a){return a.reduce((n,s)=>n+dur(s),0)}function clean(s){let e=Number(s.energy),b=Number(s.bpm);return{id:String(s.id||uid()),title:String(s.title||'').trim(),artist:String(s.artist||'').trim(),duration:secs(String(s.duration||''))?String(s.duration):'',bpm:b>=20&&b<=350?b:null,energy:e>=1&&e<=10?Math.round(e):null,source:String(s.source||''),energySource:String(s.energySource||(e>=1&&e<=10?'Manuale':''))}}function makeLib(name){return{id:uid(),name,band:'',logo:'',songs:[],ordered:[],shows:[],showName:'My Live Show',style:'live',limit:'',encore:0,resultEncore:0}}
let state={active:'',libraries:[]},editing=null,busy=false,stop=false;try{const old=JSON.parse(localStorage.getItem('setflow-v2')||'null');if(old?.libraries?.length)state=old;else{let l=makeLib('Il mio repertorio');const v=JSON.parse(localStorage.getItem('setflow-v1')||'null');if(v){l.songs=(v.songs||[]).map(clean);l.ordered=v.ordered||[];l.showName=v.name||l.showName;l.style=v.style||'live'}state={active:l.id,libraries:[l]}}}catch(e){}if(!state.libraries.length){let l=makeLib('Il mio repertorio');state={active:l.id,libraries:[l]}}const lib=()=>state.libraries.find(l=>l.id===state.active)||state.libraries[0];function save(){try{localStorage.setItem('setflow-v2',JSON.stringify(state));$('storageStatus').textContent='Salvato su questo browser. Esporta un backup per trasferire i dati.'}catch(e){$('storageStatus').textContent='Salvataggio non riuscito: esporta subito un backup.'}}function rows(){return lib().ordered.map(id=>lib().songs.find(s=>s.id===id)).filter(Boolean)}function resetForm(){editing=null;$('songForm').reset();$('addBtn').textContent='Aggiungi brano'}function invalidate(){lib().ordered=[];lib().resultEncore=0}function add(s){s=clean(s);if(!s.title)return false;if(lib().songs.some(x=>norm(x.title)===norm(s.title)&&norm(x.artist)===norm(s.artist)))return false;lib().songs.push(s);invalidate();return true}
function render(){const l=lib();$('count').textContent=l.songs.length;$('time').textContent=fmt(total(l.songs))+(l.songs.some(s=>!s.duration)?' ~':'');$('average').textContent=l.songs.length?(l.songs.reduce((a,s)=>a+en(s),0)/l.songs.length).toFixed(1)+(l.songs.some(s=>!s.energy)?' ~':''):'—';$('songs').innerHTML=l.songs.map((s,i)=>`<tr><td><b>${esc(s.title)}</b><small>${esc(s.artist)} ${esc(s.source)}</small></td><td>${s.duration||'~4:00'}</td><td>${s.bpm||'—'}</td><td>${s.energy||'~6'}/10<small>${esc(s.energySource||'Da valutare')}</small></td><td><button class="secondary" data-edit="${i}">✎</button><button class="secondary danger" data-del="${i}">×</button></td></tr>`).join('');$('missing').textContent=l.songs.filter(s=>!s.energy||!s.duration||s.energySource==='Stima genere').length+' brani con durata o energia da verificare.';$('librarySelect').innerHTML=state.libraries.map(x=>`<option value="${esc(x.id)}">${esc(x.name)}</option>`).join('');$('librarySelect').value=l.id;$('savedShows').innerHTML='<option value="">Scalette archiviate</option>'+l.shows.map(x=>`<option value="${esc(x.id)}">${esc(x.name)}</option>`).join('');renderResult();save()}
function loadLib(){const l=lib();state.active=l.id;for(const k of ['band','showName','style','limit','encore'])$(k).value=l[k]??'';resetForm();$('searchResults').textContent='';$('message').textContent='';render()}
for(const k of ['band','showName','style','limit','encore'])$(k).addEventListener('change',()=>{lib()[k]=$(k).value;if(['style','limit','encore'].includes(k))invalidate();render()});$('librarySelect').onchange=()=>{if(busy){$('librarySelect').value=lib().id;return}state.active=$('librarySelect').value;loadLib()};$('newLib').onclick=()=>{if(busy)return;let n=prompt('Nome del repertorio');if(!n?.trim())return;let l=makeLib(n.trim());state.libraries.push(l);state.active=l.id;loadLib()};$('renameLib').onclick=()=>{let n=prompt('Nome del repertorio',lib().name);if(n?.trim()){lib().name=n.trim();render()}};$('removeLib').onclick=()=>{if(busy||!confirm('Eliminare il repertorio attivo e le sue scalette?'))return;state.libraries=state.libraries.filter(l=>l.id!==lib().id);if(!state.libraries.length)state.libraries.push(makeLib('Il mio repertorio'));state.active=state.libraries[0].id;loadLib()};$('logoFile').onchange=async()=>{let f=$('logoFile').files[0];if(!f)return;if(f.size>500000){alert('Usa un logo inferiore a 500 KB');return}let l=lib(),r=new FileReader();r.onload=()=>{l.logo=r.result;render()};r.readAsDataURL(f)};
$('songForm').onsubmit=e=>{e.preventDefault();let s=clean({id:editing||uid(),title:$('title').value,artist:$('artist').value,duration:$('duration').value,bpm:$('bpm').value,energy:$('energy').value});if(editing){let i=lib().songs.findIndex(x=>x.id===editing);if(i>=0)lib().songs[i]=s;invalidate()}else if(!add(s)){alert('Brano già presente o titolo mancante');return}resetForm();render()};$('cancelEdit').onclick=resetForm;$('songs').onclick=e=>{let b=e.target.closest('button');if(!b)return;if(b.dataset.edit!==undefined){let s=lib().songs[Number(b.dataset.edit)];editing=s.id;for(const k of ['title','artist','duration','bpm','energy'])$(k).value=s[k]??'';$('addBtn').textContent='Salva modifiche';$('manual').scrollIntoView({behavior:'smooth'})}if(b.dataset.del!==undefined){lib().songs.splice(Number(b.dataset.del),1);resetForm();invalidate();render()}};$('clear').onclick=()=>{if(confirm('Svuotare il repertorio? Le scalette archiviate rimangono.')){lib().songs=[];invalidate();resetForm();render()}};
function parseLine(line){let p=line.trim().replace(/^\d+[.)]\s+/,'').split(/\s+[-–—]\s+|\t/);return{title:p.shift(),artist:p.join(' - ')}}$('bulkBtn').onclick=()=>{let n=0;$('bulk').value.split(/\r?\n/).filter(x=>x.trim()).forEach(x=>{if(add(parseLine(x)))n++});$('importStatus').textContent=n+' brani aggiunti; duplicati ignorati.';render()};
function csv(text){let sep=text.split(/\r?\n/)[0].includes(';')?';':text.split(/\r?\n/)[0].includes('\t')?'\t':',';let rows=[],r=[],v='',q=false;for(let i=0;i<text.length;i++){let c=text[i];if(c==='"'){if(q&&text[i+1]==='"'){v+='"';i++}else q=!q}else if(!q&&c===sep){r.push(v);v=''}else if(!q&&(c==='\n'||c==='\r')){if(c==='\r'&&text[i+1]==='\n')i++;r.push(v);rows.push(r);r=[];v=''}else v+=c}r.push(v);rows.push(r);return rows}function importRows(a){if(!a.length)return 0;let keys=a[0].map(norm),aliases=[['titolo','title','brano','song'],['artista','artist'],['durata','duration'],['bpm'],['energia','energy']];let ix=aliases.map(v=>keys.findIndex(k=>v.includes(k)));let header=ix[0]>=0;if(!header)ix=[0,1,2,3,4];let n=0;for(let r of a.slice(header?1:0)){let d=r[ix[2]];if(typeof d==='number'&&d>0&&d<1)d=fmt(d*86400);if(add({title:r[ix[0]],artist:r[ix[1]],duration:String(d??''),bpm:r[ix[3]],energy:r[ix[4]]}))n++}return n}function loadXLSX(){return new Promise((ok,no)=>{if(window.XLSX)return ok();let s=document.createElement('script');s.src='https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';s.onload=ok;s.onerror=no;document.head.append(s)})}$('file').onchange=async()=>{let f=$('file').files[0];if(!f)return;try{let a;if(/\.csv$/i.test(f.name))a=csv((await f.text()).replace(/^\uFEFF/,''));else{await loadXLSX();let w=XLSX.read(await f.arrayBuffer());a=XLSX.utils.sheet_to_json(w.Sheets[w.SheetNames[0]],{header:1,defval:''})}let n=importRows(a);$('importStatus').textContent=n+' brani importati dal primo foglio.';render()}catch(e){$('importStatus').textContent='Importazione non riuscita. Prova a salvare il file come CSV.'}$('file').value=''};
function estimate(g){g=norm(g);if(/classical|jazz|ambient|easy listening/.test(g))return 4;if(/metal|hard rock|dance/.test(g))return 8;if(/rock|hip hop|electronic/.test(g))return 7;if(/pop|latin|r b/.test(g))return 6;return null}let lastRequest=0;async function lookup(q){let wait=Math.max(0,3200-(Date.now()-lastRequest));if(wait)await new Promise(r=>setTimeout(r,wait));lastRequest=Date.now();let url='https://itunes.apple.com/search?'+new URLSearchParams({term:q,entity:'song',country:'IT',limit:'12'});let controller=new AbortController(),timer=setTimeout(()=>controller.abort(),12000);try{let r=await fetch(url,{signal:controller.signal});if(!r.ok)throw Error('Catalogo non disponibile');return (await r.json()).results.filter(x=>x.trackName&&x.artistName)}finally{clearTimeout(timer)}}function fromTrack(t){let e=estimate(t.primaryGenreName);return{title:t.trackName,artist:t.artistName,duration:t.trackTimeMillis?fmt(t.trackTimeMillis/1000):'',energy:e,source:'iTunes · '+(t.primaryGenreName||''),energySource:e?'Stima genere':''}}$('searchBtn').onclick=async()=>{let q=$('search').value.trim();if(!q||busy)return;busy=true;$('searchBtn').disabled=true;$('searchResults').textContent='Ricerca in corso…';try{let a=await lookup(q);$('searchResults').replaceChildren();if(!a.length)$('searchResults').textContent='Nessun risultato. Inserisci il brano manualmente.';for(let t of a){let s=fromTrack(t),r=document.createElement('div');r.className='actions';let text=document.createElement('span');text.style.flex='1';text.textContent=s.title+' — '+s.artist+' · '+s.duration+' · '+(s.energy?'Energia stimata '+s.energy:'/ energia da valutare');let b=document.createElement('button');b.textContent='Aggiungi';b.onclick=()=>{if(add(s)){b.textContent='Aggiunto';b.disabled=true;render()}else alert('Brano già presente')};r.append(text,b);$('searchResults').append(r)}}catch(e){$('searchResults').textContent='Ricerca non disponibile. Puoi importare o inserire manualmente.'}finally{busy=false;$('searchBtn').disabled=false}};
$('enrichBtn').onclick=async()=>{if(busy)return;let l=lib(),pending=l.songs.filter(s=>!s.source&&(!s.duration||!s.energy));if(!pending.length){$('importStatus').textContent='Nessun brano da cercare.';return}busy=true;stop=false;$('enrichBtn').disabled=true;$('stopBtn').disabled=false;let n=0,i=0;try{for(let s of pending){if(stop)break;$('importStatus').textContent=`Ricerca ${++i}/${pending.length}: ${s.title}`;let a=await lookup(s.title+' '+s.artist);let matches=a.filter(t=>norm(t.trackName)===norm(s.title)&&s.artist&&norm(t.artistName)===norm(s.artist));if(matches.length&&l.songs.includes(s)){let t=fromTrack(matches[0]);s.duration=s.duration||t.duration;if(!s.energy){s.energy=t.energy;s.energySource=t.energySource}s.source=t.source;n++;invalidate();save()}}$('importStatus').textContent=`${n} brani aggiornati. I non riconosciuti richiedono verifica manuale.`}catch(e){$('importStatus').textContent=`Ricerca interrotta: ${n} aggiornati. Riprova o usa la ricerca singola.`}finally{busy=false;$('enrichBtn').disabled=false;$('stopBtn').disabled=true;render()}};$('stopBtn').onclick=()=>stop=true;
