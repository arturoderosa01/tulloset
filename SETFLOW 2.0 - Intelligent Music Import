<!doctype html><html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="author" content="Arturo De Rosa"><title>SETFLOW 2.0 — The Intelligent Setlist</title><style>
:root{color-scheme:dark;--a:#caff45;--bg:#111318;--p:#1c2027;--b:#343943;--m:#a6adb8}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#f4f4f4;font:15px Arial,sans-serif}header,footer{padding:24px 5%;border-bottom:1px solid var(--b)}header{display:flex;gap:16px;align-items:center}.logo{font-size:30px;font-weight:900;letter-spacing:4px;color:var(--a)}small,.muted,label{color:var(--m)}header small{letter-spacing:2px}main{max-width:1120px;margin:auto;padding:24px 16px}h1{font-size:clamp(32px,5vw,48px);letter-spacing:-2px;margin:12px 0}h2{font-size:20px;margin:0 0 16px}p{line-height:1.5}.panel{background:var(--p);border:1px solid var(--b);border-radius:16px;padding:20px;margin:18px 0}.fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:12px}label{display:block;font-size:12px;margin-bottom:5px}input,textarea,select{background:var(--bg);border:1px solid var(--b);border-radius:8px;color:white;padding:11px;width:100%;font:inherit}button{background:var(--a);color:#111;border:0;border-radius:8px;padding:11px 15px;font-weight:bold;cursor:pointer}button:disabled{opacity:.5;cursor:wait}.secondary{background:#343943;color:white}.danger{color:#ff9292}.actions{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.scroll{overflow:auto}table{width:100%;border-collapse:collapse;text-align:left}td,th{padding:10px 7px;border-bottom:1px solid var(--b)}th{font-size:11px;color:var(--m);text-transform:uppercase}td button{padding:7px;margin:2px}td small{display:block;margin-top:4px}.accent{color:var(--a)}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.stat{background:var(--p);padding:14px;border-radius:10px}.stat strong{display:block;color:var(--a);font-size:24px;margin-top:8px}footer{text-align:center;border-top:1px solid var(--b);color:var(--m);font-size:12px;line-height:1.8}svg{width:100%;height:auto}#bandLogo{max-width:80px;max-height:80px;object-fit:contain} [hidden]{display:none!important} @media print{body{background:white;col